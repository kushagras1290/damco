# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (docker compose overrides the host to `postgres`) ---
POSTGRES_PASSWORD=jobpulse
DATABASE_URL=postgresql+psycopg://jobpulse:jobpulse@localhost:5432/jobpulse

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=jobpulse
# Temporal Cloud: set TEMPORAL_API_KEY and TEMPORAL_TLS=true
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# --- Auth: shared secret between web (mints JWTs) and API (verifies) ---
API_JWT_SECRET=change-me-to-a-long-random-secret-of-48-chars
PUBLIC_DEMO_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Web (Auth.js v5 + GitHub OAuth) ---
AUTH_SECRET=change-me-to-another-long-random-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins that receive the OWNER role.
OWNER_GITHUB_LOGINS=
API_BASE_URL=http://localhost:8000

# --- OpenAI (optional; without a key JobPulse runs deterministic-only) ---
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-5-mini
OPENAI_REASONING_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens, used for the llm_cost_usd_total metric
OPENAI_INPUT_PRICE_PER_MILLION=0
OPENAI_OUTPUT_PRICE_PER_MILLION=0
OPENAI_EMBEDDING_PRICE_PER_MILLION=0

# --- Outbound fetching (SSRF guard) ---
OUTBOUND_ENFORCE_ALLOWLIST=true
# Extra hosts allowed in addition to Greenhouse/Lever/Ashby/Resend and each source's own host
OUTBOUND_ALLOWED_HOSTS=

# --- Snapshot storage: local | r2 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.data/snapshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Notifications ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
WEBHOOK_SIGNING_SECRET=
DASHBOARD_BASE_URL=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
