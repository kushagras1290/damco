# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=local
# Web app uses the same value: `production` turns on strict config validation.
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (docker compose overrides the host to `postgres`) ---
POSTGRES_PASSWORD=jobpulse
DATABASE_URL=postgresql+psycopg://jobpulse:jobpulse@localhost:5432/jobpulse
# Non-owner role each transaction switches to so row-level security applies (created by
# migration 0002). Leave as is unless your DBA provisions a differently named role.
DB_TENANT_ROLE=jobpulse_app

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=jobpulse
# Temporal Cloud: set TEMPORAL_API_KEY and TEMPORAL_TLS=true
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# --- Auth: web signs short-lived Ed25519 tokens, API verifies with public keys only ---
# Generate a pair with:  uv run python -m jobpulse.keys   (or: make keys)
API_JWT_PRIVATE_JWK=
API_JWT_JWKS=
# Platform admins: immutable numeric GitHub user ids (find yours: gh api users/<login> --jq .id).
# They own the Default workspace (the public demo). API only - the web app does not need it.
OWNER_GITHUB_IDS=
PUBLIC_DEMO_ENABLED=true
# Who may create an account: open (anyone; gets a personal workspace) | invite (join by
# invitation only) | closed (platform admins only).
SIGNUP_POLICY=open
# Browsers never call the API directly (the web app proxies server-side), so CORS stays
# deny-all. Only list exact origins (scheme://host[:port]) if you add a browser client.
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies in front of the API whose X-Forwarded-For you trust (0 = none).
TRUSTED_PROXY_COUNT=0

# --- Redis (shared rate-limit windows, response cache, idempotency keys) ---
# Optional locally (the API falls back to per-instance limits); required by the API in
# production. docker compose sets REDIS_URL to its own `redis` service.
REDIS_PASSWORD=jobpulse
REDIS_URL=redis://:jobpulse@localhost:6379/0

# --- Rate limits (sliding window, per verified user / signed visitor / client IP) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS=120
RATE_LIMIT_AUTHENTICATED=600
RATE_LIMIT_WRITES=60
RATE_LIMIT_STREAM_CONNECTS=20
REQUEST_TIMEOUT_SECONDS=30

# --- Realtime (Server-Sent Events fed by PostgreSQL LISTEN/NOTIFY) ---
# LISTEN needs a session connection: behind a transaction pooler (e.g. Neon "-pooler"
# hosts) set this to the direct, unpooled URL. Empty = use DATABASE_URL.
DATABASE_LISTEN_URL=
SSE_MAX_CLIENTS=200

# --- Demo mode: enables the built-in "Demo board" source (fictional postings that
# appear live every poll). Never enable in production.
DEMO_MODE=false

# --- Web (Auth.js v5 + GitHub OAuth) ---
# 32+ random bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Canonical public URL of the web app (required in production; enables secure cookies).
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
API_BASE_URL=http://localhost:8000
# Proxies in front of the web app whose X-Forwarded-For is trusted, used to give each anonymous
# visitor its own rate-limit bucket. Empty = 1 on Vercel, 0 elsewhere (header ignored).
TRUSTED_PROXY_HOPS=

# --- OpenAI (optional; without a key JobPulse runs deterministic-only) ---
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-5-mini
OPENAI_REASONING_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens, used for the llm_cost_usd_total metric
OPENAI_INPUT_PRICE_PER_MILLION=0
OPENAI_OUTPUT_PRICE_PER_MILLION=0
OPENAI_EMBEDDING_PRICE_PER_MILLION=0

# --- Outbound fetching (SSRF guard) ---
OUTBOUND_ENFORCE_ALLOWLIST=true
# Extra hosts allowed in addition to Greenhouse/Lever/Ashby/Resend and each source's own host
OUTBOUND_ALLOWED_HOSTS=

# --- Snapshot storage: local | r2 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.data/snapshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Notifications ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
WEBHOOK_SIGNING_SECRET=
DASHBOARD_BASE_URL=http://localhost:3000

# --- Billing (Razorpay). Leave empty to run without online payments (plans can still be set
# by a platform admin). Plans change ONLY through verified webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids from the Razorpay dashboard (Subscriptions -> Plans), monthly.
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_TEAM=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
